# Local MinIO credentials for development.
# Copy to `.env` before running docker compose.
MINIO_ROOT_USER=tccadmin
MINIO_ROOT_PASSWORD=tccadmin123

# Values consumed by Python/DVC setup scripts on the WSL host.
# Inside docker-compose, data-pipeline overrides MINIO_ENDPOINT to minio:9000.
MINIO_ENDPOINT=localhost:9000
MINIO_CONSOLE=http://localhost:9001
MINIO_ACCESS_KEY=tccadmin
MINIO_SECRET_KEY=tccadmin123
MINIO_BUCKET=tcc-datalake
MINIO_DVC_PREFIX=dvc
MINIO_LAKE_PREFIX=lake
MINIO_SECURE=false
DVC_REMOTE_NAME=minio
